# --- Secrets (set these in production) -------------------------------------
# Admin key for the management dashboard/API. If unset, a random key is
# generated on first boot and printed to the server logs.
ADMIN_KEY=

# Master secret used to derive per-playlist encryption keys for relay links.
# If unset, a random secret is generated and persisted to .data/secrets.json.
# Changing this invalidates all previously issued relay links.
RELAY_SECRET=

# --- Public URL ------------------------------------------------------------
# Absolute base URL clients use to reach this app (no trailing slash).
# If unset, it is derived from the incoming request (X-Forwarded-* aware).
PUBLIC_BASE_URL=

# --- Tuning (all optional, sensible defaults) ------------------------------
# How long a signed relay link stays valid, in seconds (default 21600 = 6h).
RELAY_LINK_TTL=21600
# Cache TTL for the upstream source playlist fetch, seconds (default 60).
UPSTREAM_CACHE_TTL=60
# Cache TTL for nested HLS manifests, seconds (default 3).
MANIFEST_CACHE_TTL=3
# Max bytes of a single response cached in memory (default 2097152 = 2MB).
MAX_CACHE_BYTES=2097152
# Per-playlist sustained rate, requests/minute (default 600).
RATE_LIMIT_RPM=600
# Per-playlist burst allowance / token bucket size (default 120).
RATE_LIMIT_BURST=120
